# Basis-URL für Canonicals, Sitemap und Share-Bilder (lib/site-url.ts)
SITE_URL=https://www.paintfix.de

# Mailversand über Resend (lib/forms/mail.ts). Ohne diese Werte zeigt die Produktion bei jedem
# Formular den Hinweis mit Telefonnummer.
RESEND_API_KEY=
# Absender mit bei Resend bestätigter Domain (Adressen hier nur Beispiele)
MAIL_FROM="PaintFix <anfrage@paintfix.de>"
# optional, sonst MAIL_FROM
MAIL_FROM_AVIATION="PaintFix Aviation <ops@paintfix-aviation.de>"
# Postfach für Anfragen
MAIL_TO=
# optional, sonst MAIL_TO
MAIL_TO_AVIATION=
