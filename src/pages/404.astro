---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { path } from '@/i18n/routes';
import { t } from '@/i18n/ui';

const s = t('de');
const en = t('en');
---

<BaseLayout
  locale="de"
  routeKey="home"
  theme="auto"
  title="Seite nicht gefunden | Paintfix"
  description={s.notFound.text}
  noindex
>
  <section class="section">
    <div class="container nf">
      <span class="kicker">404</span>
      <h1 class="display display-l">{s.notFound.title}</h1>
      <p class="lead">{s.notFound.text} <span lang="en-GB">{en.notFound.title}</span></p>
      <ul class="links">
        <li><a class="btn" href={path('car', 'de')}>{s.nav.car}</a></li>
        <li><a class="btn btn-outline" href={path('aviation', 'de')}>{s.nav.aviation}</a></li>
        <li><a class="btn-link" href={path('home', 'en')} lang="en-GB">English site</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1.5rem;
    min-height: 50vh;
    align-content: center;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1rem;
  }
</style>
