---
import { routes, htmlLang, type Locale, type RouteKey } from '@/i18n/routes';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: RouteKey;
  theme: 'auto' | 'aviation';
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, locale, routeKey, theme, ogImage, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(routes[routeKey][locale], site).toString();
const alternates = (['de', 'en'] as const).map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(routes[routeKey][l], site).toString(),
}));
const xDefault = new URL(routes[routeKey].de, site).toString();
const image = new URL(
  ogImage ?? (theme === 'aviation' ? '/og/aviation.png' : '/og/paintfix.png'),
  site,
).toString();
const siteName = theme === 'aviation' ? 'Paintfix Aviation' : 'Paintfix';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_GB'} />
<meta property="og:locale:alternate" content={locale === 'de' ? 'en_GB' : 'de_DE'} />
<meta name="twitter:card" content="summary_large_image" />
