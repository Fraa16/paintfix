---
import SkyScene from './SkyScene.astro';
import Logo from '@/components/global/Logo.astro';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  kicker: string;
  title: readonly string[];
  text: string;
  cta: string;
  href: string;
}
const { locale, kicker, title, text, cta, href } = Astro.props;
---

<section class="interlude" data-theme="aviation" data-parallax-scope>
  <SkyScene locale={locale} variant="interlude" />
  <div class="container content">
    <div class="copy" data-reveal>
      <Logo variant="seal" class="seal" />
      <span class="kicker">{kicker}</span>
      <h2 class="display display-l">
        {title.map((l) => <span class="block">{l}</span>)}
      </h2>
      <p class="lead">{text}</p>
      <a href={href} class="btn">{cta} <span class="chev" aria-hidden="true">›</span></a>
    </div>
  </div>
</section>

<style>
  .interlude {
    position: relative;
    min-height: clamp(34rem, 88vh, 52rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--cloud);
  }
  .content {
    position: relative;
    z-index: 2;
    padding-block: 6rem;
  }
  .copy {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
  }
  .copy :global(.seal) {
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.5rem;
  }
  .block {
    display: block;
  }
  .lead {
    color: rgb(245 243 238 / 0.82);
  }
  .btn {
    justify-self: start;
    margin-top: 0.5rem;
  }
  @media (max-width: 760px) {
    .interlude {
      align-items: flex-start;
      min-height: 46rem;
    }
    .content {
      padding-block: 4.5rem 15rem;
    }
  }
</style>
