---
/** Car page → aviation: aviation as a quality proof, never as a price signal. */
import Logo from '@/components/global/Logo.astro';

interface Props {
  title: readonly string[];
  text: string;
  cta: string;
  href: string;
}
const { title, text, cta, href } = Astro.props;
---

<section class="bridge" data-theme="aviation">
  <div class="container inner" data-reveal>
    <Logo variant="seal" class="seal" />
    <div class="copy">
      <p class="display display-m">
        {title.map((l, i) => <span class:list={['block', { gold: i === 1 }]}>{l}</span>)}
      </p>
      <p class="text">{text}</p>
    </div>
    <a href={href} class="btn">{cta} <span class="chev" aria-hidden="true">›</span></a>
  </div>
</section>

<style>
  .bridge {
    background: var(--navy);
    color: var(--cloud);
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
    background-image: radial-gradient(
      120% 140% at 85% 120%,
      rgb(201 138 90 / 0.28),
      transparent 60%
    );
  }
  .inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem 3rem;
  }
  .inner :global(.seal) {
    width: 4.5rem;
    height: 4.5rem;
  }
  .block {
    display: block;
  }
  .gold {
    color: var(--gold);
  }
  .text {
    margin-top: 0.75rem;
    color: rgb(245 243 238 / 0.78);
    max-width: 40rem;
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
    .btn {
      justify-self: start;
    }
  }
</style>
