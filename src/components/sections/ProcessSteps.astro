---
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: readonly Step[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="step" data-reveal style={`--reveal-i: ${i}`}>
        <span class="num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="step-title">{s.title}</h3>
        <p class="step-text">{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    counter-reset: step;
  }
  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line);
  }
  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 1px;
    background: var(--c-accent);
  }
  .num {
    font-size: 0.8rem;
    font-weight: 620;
    font-stretch: var(--kicker-stretch);
    letter-spacing: 0.18em;
    color: var(--c-kicker);
  }
  .step-title {
    font-size: 1.15rem;
    font-weight: 640;
    font-stretch: var(--display-stretch);
    line-height: 1.3;
  }
  :global([data-theme='aviation']) .step-title {
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .step-text {
    font-size: 0.95rem;
    color: var(--c-muted);
  }
  @media (max-width: 960px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
