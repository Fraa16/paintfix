---
import SectionHeader from './SectionHeader.astro';
import DraftMark from '@/components/global/DraftMark.astro';
import Icon from '@/components/ui/Icon.astro';
import type { FaqItem } from '@/lib/content';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  kicker: string;
  title: readonly string[];
  items: FaqItem[];
  tone?: string;
  id?: string;
}
const { locale, kicker, title, items, tone = 'base', id } = Astro.props;
---

<section class:list={['section', `tone-${tone}`]} id={id}>
  <div class="container faq-grid">
    <SectionHeader kicker={kicker} title={title} size="m" class="faq-head" />
    <div class="faq-list">
      {
        items.map((f, i) => (
          <details class="faq-item" open={i === 0} data-reveal>
            <summary>
              <h3 class="q">
                {f.q}
                <DraftMark draft={f.draft} locale={locale} />
              </h3>
              <Icon name="plus" size={20} class="toggle" />
            </summary>
            <p class="a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem 5rem;
    align-items: start;
  }
  .faq-grid :global(.faq-head) {
    position: sticky;
    top: 7rem;
  }
  .faq-item {
    border-top: 1px solid var(--c-line);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--c-line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    font-size: 1.08rem;
    font-weight: 620;
    line-height: 1.4;
  }
  summary :global(.toggle) {
    flex-shrink: 0;
    color: var(--c-accent);
    transition: transform 0.35s var(--ease-glide);
  }
  details[open] summary :global(.toggle) {
    transform: rotate(45deg);
  }
  .a {
    padding-bottom: 1.6rem;
    color: var(--c-muted);
    max-width: 44rem;
  }
  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .faq-grid :global(.faq-head) {
      position: static;
    }
  }
</style>
