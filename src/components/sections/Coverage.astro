---
/** Coverage "radar": airfields plotted from real coordinates around the base (GlobalJet-style line geometry). */
import DraftMark from '@/components/global/DraftMark.astro';
import { getAirfields } from '@/lib/content';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  baseLabel: string;
  km: string;
}
const { locale, baseLabel, km } = Astro.props;
const airfields = await getAirfields();
const base = airfields.find((a) => a.data.base) ?? airfields[0];

const R = 6371;
const rad = (d: number) => (d * Math.PI) / 180;
function distanceKm(a: { lat: number; lng: number }, b: { lat: number; lng: number }) {
  const dLat = rad(b.lat - a.lat);
  const dLng = rad(b.lng - a.lng);
  const h =
    Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
}

const size = 640;
const c = size / 2;
const maxKm = 160;
const scale = (c - 40) / maxKm;
const kx = 111.32 * Math.cos(rad(base.data.lat));
const ky = 110.57;
const points = airfields.map((a) => {
  const x = c + (a.data.lng - base.data.lng) * kx * scale;
  const y = c - (a.data.lat - base.data.lat) * ky * scale;
  const dist = Math.round(distanceKm(base.data, a.data));
  const labelLeft = x < c - 20;
  return { ...a.data, id: a.id, x, y, dist, labelLeft };
});
const rings = [50, 100, 150];
const list = [...points].sort((a, b) => a.dist - b.dist);
---

<div class="coverage">
  <figure class="radar" data-reveal>
    <svg viewBox={`0 0 ${size} ${size}`} role="img" aria-labelledby="radar-title">
      <title id="radar-title">
        {
          locale === 'de'
            ? 'Einsatzgebiet rund um den Flugplatz Münster-Telgte'
            : 'Coverage around Münster-Telgte airfield'
        }
      </title>
      <g fill="none" stroke="currentColor" class="rings">
        {rings.map((r) => <circle cx={c} cy={c} r={r * scale} />)}
        <line x1={c} y1="20" x2={c} y2={size - 20}></line>
        <line x1="20" y1={c} x2={size - 20} y2={c}></line>
      </g>
      {
        rings.map((r) => (
          <text x={c + 6} y={c - r * scale - 6} class="ring-label">
            {r} {km}
          </text>
        ))
      }
      <text x={c} y="14" text-anchor="middle" class="north">N</text>
      <g class="spokes">
        {points.filter((p) => !p.base).map((p) => <line x1={c} y1={c} x2={p.x} y2={p.y} />)}
      </g>
      {
        points.map((p) =>
          p.base ? (
            <g class="base">
              <circle cx={p.x} cy={p.y} r="14" class="base-ring" />
              <circle cx={p.x} cy={p.y} r="4.5" class="dot" />
              <text x={p.x + 20} y={p.y + 4} class="icao">
                {p.icao}
              </text>
            </g>
          ) : (
            <g>
              <circle cx={p.x} cy={p.y} r="4" class="dot" />
              <text
                x={p.labelLeft ? p.x - 10 : p.x + 10}
                y={p.y + 4}
                text-anchor={p.labelLeft ? 'end' : 'start'}
                class="icao"
              >
                {p.icao}
              </text>
            </g>
          ),
        )
      }
    </svg>
  </figure>
  <ul class="list">
    {
      list.map((p) => (
        <li data-reveal>
          <span class="code">{p.icao}</span>
          <span class="nm">
            {p.name}
            <span class="city">
              {p.city}
              <DraftMark draft={p.draft} locale={locale} />
            </span>
          </span>
          <span class="dist">{p.base ? baseLabel : `${p.dist} ${km}`}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .coverage {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: center;
  }
  .radar svg {
    width: 100%;
    height: auto;
    color: var(--c-line);
    overflow: visible;
  }
  .rings circle,
  .rings line {
    stroke: rgb(245 243 238 / 0.14);
    stroke-width: 1;
  }
  .ring-label,
  .north {
    fill: var(--c-muted);
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .spokes line {
    stroke: rgb(194 163 107 / 0.35);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }
  .dot {
    fill: var(--gold);
  }
  .base-ring {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.25;
  }
  .icao {
    fill: var(--cloud);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .base .icao {
    fill: var(--gold);
  }
  .list li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--c-line);
  }
  .list li:last-child {
    border-bottom: 1px solid var(--c-line);
  }
  .code {
    font-weight: 600;
    font-stretch: 125%;
    letter-spacing: 0.14em;
    color: var(--gold);
  }
  .nm {
    display: grid;
    font-size: 0.98rem;
  }
  .city {
    font-size: 0.82rem;
    color: var(--c-muted);
  }
  .dist {
    font-size: 0.8rem;
    font-stretch: 115%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  @media (max-width: 960px) {
    .coverage {
      grid-template-columns: minmax(0, 1fr);
    }
    .list li {
      grid-template-columns: 3.75rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }
    .radar {
      max-width: 34rem;
    }
  }
</style>
