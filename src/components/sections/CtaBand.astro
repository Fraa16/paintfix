---
interface Props {
  title: readonly string[];
  text: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  aviation?: boolean;
}
const { title, text, primary, secondary, aviation = false } = Astro.props;
---

<section class:list={['cta-band', aviation ? 'tone-panel' : 'tone-panel']}>
  <div class="container inner" data-reveal>
    <h2 class="display display-l">
      {title.map((l, i) => <span class:list={['block', { soft: i > 0 && !aviation }]}>{l}</span>)}
    </h2>
    <div class="side">
      <p class="text">{text}</p>
      <div class="actions">
        <a href={primary.href} class="btn"
          >{primary.label}
          {
            aviation && (
              <span class="chev" aria-hidden="true">
                ›
              </span>
            )
          }</a
        >
        {
          secondary && (
            <a href={secondary.href} class="btn-link">
              {secondary.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--c-bg);
    color: var(--c-ink);
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem 5rem;
    align-items: end;
  }
  .block {
    display: block;
  }
  .soft {
    color: color-mix(in srgb, var(--c-ink) 55%, var(--c-bg));
  }
  .text {
    color: var(--c-muted);
    margin-bottom: 1.75rem;
    max-width: 30rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
