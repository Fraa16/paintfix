---
interface Props {
  kicker: string;
  items: readonly string[];
}
const { kicker, items } = Astro.props;
---

<section class="audience tone-panel">
  <div class="container inner" data-reveal>
    <span class="kicker">{kicker}</span>
    <ul>
      {items.map((it) => <li>{it}</li>)}
    </ul>
  </div>
</section>

<style>
  .audience {
    background: var(--c-bg);
    color: var(--c-ink);
    padding-block: 2.5rem;
    border-block: 1px solid var(--c-line);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 3rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0;
  }
  li {
    font-size: 0.78rem;
    font-weight: 600;
    font-stretch: 125%;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-inline: 1.5rem;
    border-left: 1px solid rgb(194 163 107 / 0.45);
  }
  li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  @media (max-width: 700px) {
    li {
      padding-inline: 0 1rem;
      border-left: 0;
      width: 50%;
    }
  }
</style>
