---
import Icon from '@/components/ui/Icon.astro';
import DraftMark from '@/components/global/DraftMark.astro';
import { getPackages, formatPrice } from '@/lib/content';
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  /** Show only the first n packages (Home teaser). */
  limit?: number;
  compact?: boolean;
  includesLabel?: string;
  chooseLabel?: string;
  /** Link target for "request this package" (the form anchor). */
  requestHref: string;
}
const { locale, limit, compact = false, includesLabel, chooseLabel, requestHref } = Astro.props;
const s = t(locale);
const all = await getPackages();
const packages = limit ? all.slice(0, limit) : all;
const [reqPath, reqHash] = requestHref.split('#');
const requestLink = (id: string) => `${reqPath}?paket=${id}${reqHash ? `#${reqHash}` : ''}`;
---

<ul class:list={['packages', { compact }]} style={`--cols: ${packages.length}`}>
  {
    packages.map((p, i) => (
      <li
        class:list={['pkg', { popular: p.data.popular }]}
        id={`paket-${p.id}`}
        data-reveal
        style={`--reveal-i: ${i}`}
      >
        <span
          class:list={['badge', { empty: !p.data.popular }]}
          aria-hidden={p.data.popular ? undefined : 'true'}
        >
          {p.data.popular ? s.popular : ''}
        </span>
        <h3 class="pkg-name">{p.data.name[locale]}</h3>
        <p class="price">
          <span class="from">{s.priceFrom}</span>
          <span class="amount">
            {locale === 'de'
              ? `${formatPrice(p.data.priceFrom, locale)} €`
              : `€${formatPrice(p.data.priceFrom, locale)}`}
          </span>
          <DraftMark draft={p.data.draft} locale={locale} />
        </p>
        <p class="duration">
          <Icon name="clock" size={16} /> {p.data.duration[locale]}
        </p>
        <p class="summary">{p.data.summary[locale]}</p>
        {!compact && (
          <>
            <p class="inc-label">{includesLabel}</p>
            <ul class="includes">
              {p.data.includes[locale].map((item) => (
                <li>
                  <Icon name="check" size={16} />
                  {item}
                </li>
              ))}
            </ul>
            {p.data.note && <p class="note">{p.data.note[locale]}</p>}
          </>
        )}
        <a href={requestLink(p.id)} class="pkg-link" data-package={p.id}>
          {chooseLabel ?? s.cta.carBook}
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .packages {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .pkg {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    background: var(--c-card);
  }
  .pkg.popular {
    box-shadow: inset 0 3px 0 var(--c-accent);
  }
  .badge {
    align-self: flex-start;
    min-height: 1.35rem;
    margin-bottom: -0.35rem;
    padding: 0.2rem 0.6rem;
    font-size: 0.68rem;
    font-weight: 620;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-on-accent);
    background: var(--c-accent);
    border-radius: 999px;
  }
  .badge.empty {
    visibility: hidden;
  }
  .pkg-name {
    font-size: 1.2rem;
    font-weight: 640;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  @media (min-width: 1101px) {
    .packages:not(.compact) .pkg-name {
      min-height: 2.6em;
    }
  }
  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .from {
    font-size: 0.95rem;
    color: var(--c-muted);
  }
  .amount {
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.6rem);
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .duration {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--c-muted);
  }
  .summary {
    font-size: 0.98rem;
    color: var(--c-muted);
  }
  .inc-label {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-kicker);
  }
  .includes {
    display: grid;
    gap: 0.5rem;
    font-size: 0.93rem;
  }
  .includes li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 0.6rem;
    align-items: start;
  }
  .includes :global(.icon) {
    margin-top: 0.3rem;
    color: var(--c-accent);
  }
  .note {
    font-size: 0.85rem;
    color: var(--c-muted);
    font-style: italic;
  }
  .pkg-link {
    margin-top: auto;
    padding-top: 1rem;
    display: inline-flex;
    gap: 0.5rem;
    font-weight: 620;
    font-size: 0.95rem;
    color: var(--c-accent-text);
    text-decoration: none;
  }
  .pkg-link span {
    transition: transform 0.25s var(--ease-crisp);
  }
  .pkg-link:hover span {
    transform: translateX(4px);
  }
  @media (max-width: 1100px) {
    .packages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .packages {
      grid-template-columns: 1fr;
    }
  }
</style>
