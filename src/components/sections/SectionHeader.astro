---
interface Props {
  kicker?: string;
  title: string | readonly string[];
  lead?: string;
  as?: 'h1' | 'h2' | 'h3';
  size?: 'xl' | 'l' | 'm';
  align?: 'left' | 'center';
  class?: string;
  id?: string;
}
const {
  kicker,
  title,
  lead,
  as: Tag = 'h2',
  size = 'l',
  align = 'left',
  class: className,
  id,
} = Astro.props;
const lines = typeof title === 'string' ? [title] : title;
---

<div class:list={['section-header', `align-${align}`, className]} data-reveal>
  {kicker && <span class="kicker">{kicker}</span>}
  <Tag class:list={['display', `display-${size}`]} id={id}>
    {lines.map((l, i) => <span class:list={['line', { second: i > 0 }]}>{l}</span>)}
  </Tag>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

<style>
  .section-header {
    display: grid;
    gap: 1.25rem;
  }
  .align-center {
    justify-items: center;
    text-align: center;
  }
  .align-center .lead {
    margin-inline: auto;
  }
  .line {
    display: block;
  }
  :global([data-theme='auto']) .line.second {
    color: color-mix(in srgb, var(--c-ink) 55%, var(--c-bg));
  }
  .kicker {
    margin-bottom: 0.25rem;
  }
</style>
