---
/** Understated "spec cards": product, grade, purpose. Instead of a logo wall. */
import DraftMark from '@/components/global/DraftMark.astro';
import type { Locale } from '@/i18n/routes';

interface Plate {
  label: string;
  name: string;
  text: string;
  draft?: boolean;
}
interface Props {
  locale: Locale;
  plates: readonly Plate[];
}
const { locale, plates } = Astro.props;
---

<ul class="plates" style={`--n: ${plates.length}`}>
  {
    plates.map((p, i) => (
      <li class="plate" data-reveal style={`--reveal-i: ${i}`}>
        <span class="plate-label">
          {p.label}
          <DraftMark draft={p.draft ?? false} locale={locale} />
        </span>
        <h3 class="plate-name">{p.name}</h3>
        <p class="plate-text">{p.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .plates {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    border-top: 1px solid var(--c-line);
    border-left: 1px solid var(--c-line);
  }
  .plate {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    background: var(--c-card);
    border-right: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
  }
  .plate-label {
    font-size: 0.7rem;
    font-weight: 620;
    font-stretch: var(--kicker-stretch);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-kicker);
  }
  .plate-name {
    font-size: 1.15rem;
    font-weight: 640;
    font-stretch: var(--display-stretch);
    letter-spacing: 0.01em;
    line-height: 1.25;
  }
  :global([data-theme='aviation']) .plate-name {
    font-size: 1rem;
    text-transform: uppercase;
    font-weight: 600;
  }
  .plate-text {
    font-size: 0.95rem;
    color: var(--c-muted);
  }
</style>
