---
/** Image on one side, a coloured text panel on the other (Liberty's "Who we are" pattern). */
import Img from '@/components/ui/Img.astro';
import type { SlotId } from '@/content/media';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  media: SlotId;
  reverse?: boolean;
  /** Aviation: cloud layer crossing the section's top border. */
  clouds?: boolean;
  id?: string;
}
const { locale, media, reverse = false, clouds = false, id } = Astro.props;
---

<section class:list={['split', { reverse }]} id={id} data-parallax-scope>
  {
    clouds && (
      <div class="border-clouds" aria-hidden="true" data-parallax-y="-30">
        <Img slot="av-clouds-near" locale={locale} decorative />
      </div>
    )
  }
  <div class="split-media">
    <div class="media-inner" data-parallax-y="-8">
      <Img slot={media} locale={locale} sizes="(min-width: 900px) 50vw, 100vw" />
    </div>
  </div>
  <div class="split-panel tone-panel">
    <div class="panel-inner" data-reveal>
      <slot />
    </div>
  </div>
</section>

<style>
  .split {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: clamp(32rem, 80vh, 46rem);
  }
  .split.reverse .split-media {
    order: 2;
  }
  .split-media {
    position: relative;
    overflow: hidden;
    min-height: 22rem;
  }
  .media-inner {
    position: absolute;
    inset: -8% 0;
  }
  .media-inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .split-panel {
    background: var(--c-bg);
    color: var(--c-ink);
    display: flex;
    align-items: center;
  }
  .panel-inner {
    display: grid;
    gap: 1.4rem;
    padding: clamp(2.5rem, 1.5rem + 5vw, 6.5rem);
    max-width: 40rem;
  }
  .border-clouds {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    top: -5.5rem;
    height: 11rem;
    opacity: 0.8;
    pointer-events: none;
  }
  .border-clouds :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mask-image: linear-gradient(180deg, transparent 0%, #000 35%, #000 55%, transparent 100%);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split.reverse .split-media {
      order: 0;
    }
    .split-media {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
    .border-clouds {
      top: -4rem;
      height: 8rem;
    }
  }
</style>
