---
import DraftMark from '@/components/global/DraftMark.astro';
import { getAddons, formatPrice } from '@/lib/content';
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const addons = await getAddons();
---

<ul class="addons">
  {
    addons.map((a) => (
      <li class="addon" data-reveal>
        <div>
          <h3 class="name">{a.data.name[locale]}</h3>
          <p class="desc">{a.data.desc[locale]}</p>
        </div>
        {a.data.priceFrom && (
          <p class="price">
            {s.priceFrom}{' '}
            <strong>
              {locale === 'de'
                ? `${formatPrice(a.data.priceFrom, locale)} €`
                : `€${formatPrice(a.data.priceFrom, locale)}`}
            </strong>
            <DraftMark draft={a.data.draft} locale={locale} />
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .addons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 3rem;
  }
  .addon {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--c-line);
  }
  .name {
    font-weight: 620;
    font-size: 1.02rem;
  }
  .desc {
    font-size: 0.92rem;
    color: var(--c-muted);
  }
  .price {
    white-space: nowrap;
    color: var(--c-muted);
    font-size: 0.92rem;
  }
  .price strong {
    color: var(--c-ink);
    font-size: 1.05rem;
    font-weight: 660;
  }
  @media (max-width: 760px) {
    .addons {
      grid-template-columns: 1fr;
    }
  }
</style>
