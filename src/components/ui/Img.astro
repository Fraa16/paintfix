---
import { Picture } from 'astro:assets';
import { media, type SlotId } from '@/content/media';
import type { Locale } from '@/i18n/routes';

interface Props {
  slot: SlotId;
  locale: Locale;
  /** CSS sizes attribute. Defaults to full viewport width. */
  sizes?: string;
  widths?: number[];
  /** Above-the-fold hero/LCP image: eager + high fetch priority. */
  priority?: boolean;
  /** Above the fold but not the LCP candidate: eager, normal priority. */
  eager?: boolean;
  class?: string;
  /** Encoder quality override (soft, blurred layers compress well at ~50). */
  quality?: number;
  /** Decorative layers (parallax clouds etc.) get an empty alt. */
  decorative?: boolean;
  [key: `data-${string}`]: string | undefined;
}

const {
  slot,
  locale,
  sizes = '100vw',
  widths,
  priority = false,
  eager = false,
  quality,
  class: className,
  decorative = false,
  ...rest
} = Astro.props;
const m = media(slot);
const maxW = m.src.width;
const defaultWidths = [480, 768, 1080, 1440, 1920, 2400].filter((w) => w <= maxW);
const w = (widths ?? defaultWidths).filter((x) => x <= maxW);
---

<Picture
  src={m.src}
  alt={decorative ? '' : m.alt[locale]}
  formats={['avif']}
  fallbackFormat="webp"
  widths={w.length ? w : [maxW]}
  sizes={sizes}
  quality={quality ?? (m.src.format === 'png' ? 80 : 72)}
  loading={priority || eager ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={className}
  pictureAttributes={{ style: 'display: contents' }}
  data-media-source={m.source}
  {...rest}
/>
