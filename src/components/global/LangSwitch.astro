---
import { routes, htmlLang, type Locale, type RouteKey } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  class?: string;
}
const { locale, routeKey, class: className } = Astro.props;
const other: Locale = locale === 'de' ? 'en' : 'de';
const s = t(locale);
---

<a
  href={routes[routeKey][other]}
  hreflang={htmlLang[other]}
  lang={htmlLang[other]}
  class:list={['lang-switch', className]}
  aria-label={`${s.lang.label}: ${s.lang.switchTo}`}
>
  <span aria-hidden="true">{s.lang.short}</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    font-size: 0.78rem;
    font-weight: 620;
    font-stretch: var(--kicker-stretch);
    letter-spacing: 0.14em;
    text-decoration: none;
    color: var(--c-ink);
    border: 1px solid var(--c-line);
    border-radius: var(--btn-radius);
    transition: border-color 0.25s var(--ease-crisp);
  }
  .lang-switch:hover {
    border-color: var(--c-accent);
  }
</style>
