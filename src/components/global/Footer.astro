---
import Logo from './Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import DraftMark from './DraftMark.astro';
import { anchors, path, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site, isDraft } from '@/content/site';

interface Props {
  locale: Locale;
  variant: 'master' | 'aviation';
}
const { locale, variant } = Astro.props;
const s = t(locale);
const a = anchors[locale];
const isAviation = variant === 'aviation';
const year = new Date().getFullYear();

const carLinks =
  locale === 'de'
    ? [
        ['Pakete & Preise', path('car', locale, a.packages)],
        ['Innenaufbereitung', path('car', locale, 'innenraum')],
        ['Lack & Politur', path('car', locale, 'aussen')],
        ['Keramikversiegelung', path('car', locale, 'keramik')],
      ]
    : [
        ['Packages & prices', path('car', locale, a.packages)],
        ['Interior detailing', path('car', locale, 'interior')],
        ['Paint & polish', path('car', locale, 'exterior')],
        ['Ceramic coating', path('car', locale, 'ceramic')],
      ];
const aviationLinks = s.nav.aviationAnchors.map(([id, label]) => [
  label,
  path('aviation', locale, id),
]);
const email = isAviation ? site.aviationEmail : site.email;
---

<footer
  class:list={['site-footer', isAviation ? '' : 'tone-panel']}
  data-theme={isAviation ? 'aviation' : 'auto'}
>
  <div class="container">
    <div class="grid-footer">
      <div class="col-brand">
        <a
          href={isAviation ? path('aviation', locale) : path('home', locale)}
          class="f-logo"
          aria-label={isAviation ? 'Paintfix Aviation' : 'Paintfix'}
        >
          {
            isAviation ? (
              <Logo variant="aviationLockup" class="f-mark-av" />
            ) : (
              <Logo variant="wordmark" class="f-mark" />
            )
          }
        </a>
        <p class="entity">{isAviation ? s.footer.aviationEntity : s.footer.entity}</p>
      </div>

      <div>
        <p class="f-head">{isAviation ? s.nav.aviation : s.nav.car}</p>
        <ul class="f-list">
          {
            (isAviation ? aviationLinks : carLinks).map(([label, href]) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="f-head">{isAviation ? 'Paintfix' : 'Paintfix Aviation'}</p>
        {
          isAviation ? (
            <ul class="f-list">
              <li>
                <a href={path('home', locale)}>{s.nav.toMaster}</a>
              </li>
              <li>
                <a href={path('car', locale, a.packages)}>
                  {locale === 'de' ? 'Pakete & Preise' : 'Packages & prices'}
                </a>
              </li>
            </ul>
          ) : (
            <a href={path('aviation', locale)} class="f-seal-link">
              <Logo variant="seal" class="f-seal" />
              <span>{s.nav.aviation}</span>
            </a>
          )
        }
      </div>

      <div>
        <p class="f-head">{s.footer.contact}</p>
        <address class="f-address">
          {site.brand}{isAviation && ' Aviation'}<br />
          {site.street}<br />
          {site.postalCode}
          {site.city}
        </address>
        <ul class="f-list f-contact">
          <li>
            <a href={`tel:${site.phone}`}><Icon name="phone" size={16} />{site.phoneDisplay}</a>
            <DraftMark draft={isDraft('phone')} locale={locale} />
          </li>
          <li>
            <a href={`mailto:${email}`}><Icon name="mail" size={16} />{email}</a>
          </li>
        </ul>
        {
          !isAviation && (
            <dl class="f-hours">
              {site.hours[locale].map(([d, h]) => (
                <div>
                  <dt>{d}</dt>
                  <dd>{h}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>

    <div class="f-bottom">
      <p>© {year} {site.brand} · {site.owner}</p>
      <ul>
        <li><a href={path('imprint', locale)}>{s.footer.imprint}</a></li>
        <li><a href={path('privacy', locale)}>{s.footer.privacy}</a></li>
        <li><a href={path('contact', locale)}>{s.nav.contact}</a></li>
      </ul>
      <p class="tm">{s.footer.trademarks}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-bg);
    color: var(--c-ink);
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem) 2rem;
    border-top: 1px solid var(--c-line);
  }
  .grid-footer {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 3rem 2.5rem;
  }
  .f-logo {
    display: inline-block;
    color: var(--c-ink);
    margin-bottom: 1.5rem;
  }
  .f-logo :global(.f-mark) {
    height: 1.15rem;
  }
  .f-logo :global(.f-mark-av) {
    height: 2.8rem;
  }
  .entity {
    font-size: 0.95rem;
    color: var(--c-muted);
    max-width: 24rem;
  }
  .f-head {
    font-size: 0.72rem;
    font-weight: 620;
    font-stretch: var(--kicker-stretch);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-kicker);
    margin-bottom: 1.25rem;
  }
  .f-list {
    display: grid;
    gap: 0.6rem;
    font-size: 0.95rem;
  }
  .f-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-ink);
    text-decoration: none;
    opacity: 0.85;
  }
  .f-list a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .f-contact {
    margin-top: 1rem;
  }
  .f-address {
    font-style: normal;
    font-size: 0.95rem;
    color: var(--c-muted);
    line-height: 1.6;
  }
  .f-seal-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .f-seal-link :global(.f-seal) {
    height: 3.25rem;
    width: 3.25rem;
  }
  .f-seal-link:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .f-hours {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--c-muted);
  }
  .f-hours div {
    display: flex;
    gap: 1rem;
  }
  .f-hours dt {
    min-width: 5.5rem;
  }
  .f-bottom {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    font-size: 0.82rem;
    color: var(--c-muted);
  }
  .f-bottom ul {
    display: flex;
    gap: 1.5rem;
  }
  .f-bottom a {
    color: var(--c-muted);
    text-decoration: none;
  }
  .f-bottom a:hover {
    color: var(--c-ink);
  }
  .tm {
    flex-basis: 100%;
    font-size: 0.75rem;
    opacity: 0.8;
  }
  @media (max-width: 960px) {
    .grid-footer {
      grid-template-columns: 1fr 1fr;
    }
    .col-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .grid-footer {
      grid-template-columns: 1fr;
    }
  }
</style>
