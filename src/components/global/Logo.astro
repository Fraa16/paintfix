---
import { logoMarks } from './logo-paths';

interface Props {
  variant: keyof typeof logoMarks;
  class?: string;
  title?: string;
}

const { variant, class: className, title } = Astro.props;
const mark = logoMarks[variant];
---

<svg
  viewBox={mark.viewBox}
  class:list={['logo', `logo-${variant}`, className]}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {
    mark.ring && (
      <circle
        cx={mark.ring.cx}
        cy={mark.ring.cy}
        r={mark.ring.r}
        fill="none"
        stroke="var(--logo-accent, #c2a36b)"
        stroke-width={mark.ring.strokeWidth}
      />
    )
  }
  {
    mark.paths.map((p) => (
      <path
        d={p.d}
        fill={
          p.role === 'seal' || p.role === 'accent' ? 'var(--logo-accent, #c2a36b)' : 'currentColor'
        }
      />
    ))
  }
</svg>

<style>
  .logo {
    display: block;
    height: 100%;
    width: auto;
    overflow: visible;
  }
</style>
