---
import { showDrafts } from '@/content/site';
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';

interface Props {
  draft?: boolean;
  locale: Locale;
}
const { draft = true, locale } = Astro.props;
const s = t(locale);
---

{
  showDrafts && draft && (
    <span class="draft-mark" title={s.draftTitle}>
      {s.draft}
    </span>
  )
}

<style>
  .draft-mark {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-inline: 0.4em;
    padding: 0.05rem 0.45rem;
    border: 1px dashed #d97706;
    border-radius: 999px;
    background: #fff7e6;
    color: #92400e;
    font-size: 0.62rem;
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
    white-space: nowrap;
  }
</style>
