---
import '@/styles/global.css';
import fontUrl from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url';
import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/global/Header.astro';
import Footer from '@/components/global/Footer.astro';
import { htmlLang, type Locale, type RouteKey } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { showDrafts } from '@/content/site';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  theme: 'auto' | 'aviation';
  title: string;
  description: string;
  graph?: object[];
  headerOverlay?: boolean;
  noindex?: boolean;
}

const {
  locale,
  routeKey,
  theme,
  title,
  description,
  graph = [],
  headerOverlay = false,
  noindex = false,
} = Astro.props;
const s = t(locale);
const variant = theme === 'aviation' ? 'aviation' : 'master';
const themeColor = theme === 'aviation' ? '#0e1830' : '#ffffff';
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme={theme} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      locale={locale}
      routeKey={routeKey}
      theme={theme}
      noindex={noindex}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={themeColor} />
    <meta name="format-detection" content="telephone=no" />
    {graph.length > 0 && <JsonLd graph={graph} />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{s.skip}</a>
    <Header locale={locale} routeKey={routeKey} variant={variant} overlay={headerOverlay} />
    <main id="main" tabindex="-1" class:list={{ 'pt-header': !headerOverlay }}>
      <slot />
    </main>
    <Footer locale={locale} variant={variant} />
    {
      showDrafts && (
        <p class="preview-note" data-theme="auto">
          {locale === 'de'
            ? 'Vorschau · Entwürfe und Platzhalter sind markiert'
            : 'Preview · drafts and placeholders are marked'}
        </p>
      )
    }
    <script>
      import { initReveal } from '@/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--c-ink);
    color: var(--c-bg);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 0.2s;
  }
  .skip-link:focus {
    transform: none;
  }
  main:focus {
    outline: none;
  }
  .pt-header {
    padding-top: 4.5rem;
  }
  :global([data-theme='aviation']) .pt-header {
    padding-top: 5.25rem;
  }
  .preview-note {
    position: fixed;
    right: 0.75rem;
    bottom: 0.75rem;
    opacity: 0.85;
    z-index: 60;
    padding: 0.35rem 0.75rem;
    border: 1px dashed #d97706;
    border-radius: 999px;
    background: #fff7e6;
    color: #92400e;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    pointer-events: none;
  }
</style>
