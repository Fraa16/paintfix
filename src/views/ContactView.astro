---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InquiryForm from '@/components/forms/InquiryForm.astro';
import Icon from '@/components/ui/Icon.astro';
import DraftMark from '@/components/global/DraftMark.astro';
import { contactCopy } from '@/i18n/copy/contact';
import { path, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site, isDraft } from '@/content/site';
import { breadcrumb, businessGraph } from '@/lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = contactCopy[locale];
const s = t(locale);
const base = Astro.site ?? new URL(Astro.url.origin);
const graph = [
  ...businessGraph(base, locale),
  breadcrumb(base, [
    { name: 'Paintfix', path: path('home', locale) },
    { name: s.nav.contact, path: path('contact', locale) },
  ]),
];
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.street}, ${site.postalCode} ${site.city}`)}`;
---

<BaseLayout
  locale={locale}
  routeKey="contact"
  theme="auto"
  title={c.seo.title}
  description={c.seo.description}
  graph={graph}
>
  <section class="section contact" data-contact>
    <div class="container grid-contact">
      <div class="intro">
        <span class="kicker">{c.kicker}</span>
        <h1 class="display display-l">
          <span class="block" data-title-auto
            >{c.title[0]} <span class="soft">{c.title[1]}</span></span
          >
          <span class="block" data-title-aviation hidden
            >{c.titleAviation[0]} <span class="soft">{c.titleAviation[1]}</span></span
          >
        </h1>
        <p class="lead">{c.lead}</p>

        <div class="details">
          <div>
            <p class="caption-caps accent-text">{c.address}</p>
            <address>
              {site.brand}<br />
              {site.street}<br />
              {site.postalCode}
              {site.city}
            </address>
            <a href={mapsUrl} class="btn-link" rel="noopener" target="_blank">{c.route}</a>
          </div>
          <div>
            <p class="caption-caps accent-text">{c.direct}</p>
            <ul class="direct">
              <li>
                <a href={`tel:${site.phone}`}><Icon name="phone" size={18} />{site.phoneDisplay}</a>
                <DraftMark draft={isDraft('phone')} locale={locale} />
              </li>
              <li>
                <a href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a>
              </li>
              <li>
                <a href={`mailto:${site.aviationEmail}`}
                  ><Icon name="plane" size={18} />{site.aviationEmail}</a
                >
              </li>
            </ul>
          </div>
          <div>
            <p class="caption-caps accent-text">{c.hours}</p>
            <dl class="hours">
              {
                site.hours[locale].map(([d, h]) => (
                  <div>
                    <dt>{d}</dt>
                    <dd>{h}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="muted small">
              {c.byAppointment}<DraftMark draft={isDraft('hours')} locale={locale} />
            </p>
          </div>
        </div>
      </div>

      <div class="form-wrap">
        <div class="switch" role="radiogroup" aria-label={s.form.trackLabel}>
          <button type="button" role="radio" aria-checked="true" data-track="auto">
            <Icon name="check" size={16} class="tick" />
            {s.form.trackCar}
          </button>
          <button type="button" role="radio" aria-checked="false" data-track="aviation">
            <Icon name="check" size={16} class="tick" />
            {s.form.trackAviation}
          </button>
        </div>
        <div class="panel panel-auto is-active" data-panel="auto">
          <InquiryForm locale={locale} track="auto" />
        </div>
        <div class="panel panel-aviation" data-panel="aviation" data-theme="aviation">
          <InquiryForm locale={locale} track="aviation" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-contact]');
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-track]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const titleAuto = root.querySelector<HTMLElement>('[data-title-auto]');
    const titleAv = root.querySelector<HTMLElement>('[data-title-aviation]');
    const select = (track: string, focus = false) => {
      buttons.forEach((b) => {
        const on = b.dataset.track === track;
        b.setAttribute('aria-checked', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === track));
      if (titleAuto && titleAv) {
        titleAuto.hidden = track !== 'auto';
        titleAv.hidden = track === 'auto';
      }
    };
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => {
        select(b.dataset.track!);
        const url = new URL(location.href);
        url.searchParams.set('track', b.dataset.track!);
        history.replaceState(null, '', url);
      });
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const next =
            buttons[(i + (e.key === 'ArrowRight' ? 1 : buttons.length - 1)) % buttons.length];
          select(next.dataset.track!, true);
        }
      });
    });
    select(new URLSearchParams(location.search).get('track') === 'aviation' ? 'aviation' : 'auto');
  }
</script>

<style>
  .block {
    display: block;
  }
  .soft {
    color: color-mix(in srgb, var(--c-ink) 50%, var(--c-bg));
  }
  .grid-contact {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3rem 5rem;
    align-items: start;
  }
  .intro {
    display: grid;
    gap: 1.5rem;
    position: sticky;
    top: 7rem;
  }
  .details {
    display: grid;
    gap: 2rem;
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-line);
  }
  .details .caption-caps {
    margin-bottom: 0.6rem;
  }
  address {
    font-style: normal;
    margin-bottom: 0.6rem;
  }
  .direct {
    display: grid;
    gap: 0.6rem;
  }
  .direct a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .hours div {
    display: flex;
    gap: 1rem;
  }
  .hours dt {
    min-width: 6rem;
    color: var(--c-muted);
  }
  .small {
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
  .switch {
    display: inline-flex;
    padding: 0.3rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    margin-bottom: 1.5rem;
    background: var(--paper);
  }
  .switch button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.4rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-weight: 600;
    color: var(--c-muted);
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-glide),
      color 0.3s var(--ease-glide);
  }
  .switch :global(.tick) {
    display: none;
  }
  .switch [aria-checked='true'] {
    background: var(--graphite);
    color: var(--white);
  }
  .switch [data-track='aviation'][aria-checked='true'] {
    background: var(--navy);
    color: var(--gold);
  }
  .switch [aria-checked='true'] :global(.tick) {
    display: block;
  }
  .panel {
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border: 1px solid var(--c-line);
    border-radius: 6px;
    background: var(--c-bg);
  }
  .panel-aviation {
    border-radius: 0;
    background: var(--navy);
  }
  /* With JS only the selected track is shown; without JS both forms stay visible. */
  :global(.js) .panel:not(.is-active) {
    display: none;
  }
  @media (max-width: 960px) {
    .grid-contact {
      grid-template-columns: 1fr;
    }
    .intro {
      position: static;
    }
  }
</style>
