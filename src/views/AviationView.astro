---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AviationHero from '@/components/sections/AviationHero.astro';
import SplitPanel from '@/components/sections/SplitPanel.astro';
import ServicesOverHangar from '@/components/sections/ServicesOverHangar.astro';
import GiantWord from '@/components/sections/GiantWord.astro';
import Interstitial from '@/components/sections/Interstitial.astro';
import Statement from '@/components/sections/Statement.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import ProductPlates from '@/components/sections/ProductPlates.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import Coverage from '@/components/sections/Coverage.astro';
import Audience from '@/components/sections/Audience.astro';
import Faq from '@/components/sections/Faq.astro';
import SkyScene from '@/components/sections/SkyScene.astro';
import InquiryForm from '@/components/forms/InquiryForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { aviationCopy } from '@/i18n/copy/aviation';
import { path, type Locale } from '@/i18n/routes';
import { site } from '@/content/site';
import { getAviationServices, getFaqs } from '@/lib/content';
import { aviationServices, breadcrumb, businessGraph, faqPage } from '@/lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = aviationCopy[locale];
const faqs = await getFaqs('aviation', locale);
const services = await getAviationServices();
const base = Astro.site ?? new URL(Astro.url.origin);
const pagePath = path('aviation', locale);
const graph = [
  ...businessGraph(base, locale),
  ...aviationServices(
    base,
    locale,
    services.map((sv) => ({
      id: sv.id,
      name: sv.data.name[locale],
      description: sv.data.desc[locale],
    })),
  ),
  faqPage(base, pagePath, faqs),
  breadcrumb(base, [
    { name: 'Paintfix', path: path('home', locale) },
    { name: 'Paintfix Aviation', path: pagePath },
  ]),
];
const tones = ['white', 'ivory'] as const;
---

<BaseLayout
  locale={locale}
  routeKey="aviation"
  theme="aviation"
  title={c.seo.title}
  description={c.seo.description}
  graph={graph}
  headerOverlay
>
  <AviationHero
    locale={locale}
    kicker={c.hero.kicker}
    h1={c.hero.h1}
    text={c.hero.text}
    requestHref={`#${c.anchors.request}`}
    servicesHref={`#${c.anchors.services}`}
  />

  <SplitPanel locale={locale} media="av-cabin" clouds>
    <span class="kicker">{c.about.kicker}</span>
    <h2 class="display display-m">{c.about.title.map((l) => <span class="block">{l}</span>)}</h2>
    <p class="muted">{c.about.text}</p>
    <p class="emphasis">{c.about.emphasis}</p>
  </SplitPanel>

  <ServicesOverHangar
    locale={locale}
    id={c.anchors.services}
    kicker={c.services.kicker}
    title={c.services.title}
    lead={c.services.lead}
  />

  {
    c.areas.map((area, i) => (
      <GiantWord
        locale={locale}
        id={area.id}
        word={area.word}
        lead={area.lead}
        cards={area.cards}
        tone={tones[i]}
      />
    ))
  }

  <Interstitial locale={locale} media="av-interstitial" />

  <Statement soft={c.statement.soft} strong={c.statement.strong} sub={c.statement.sub} />

  <section class="section" id={c.anchors.standards}>
    <div class="container stack">
      <SectionHeader
        kicker={c.standards.kicker}
        title={c.standards.title}
        lead={c.standards.lead}
      />
      <ProductPlates locale={locale} plates={c.standards.plates} />
    </div>
  </section>

  <section class="section tone-panel" id={c.anchors.process}>
    <div class="container stack">
      <SectionHeader kicker={c.process.kicker} title={c.process.title} />
      <ProcessSteps steps={c.process.steps} />
    </div>
  </section>

  <section class="section" id={c.anchors.coverage}>
    <div class="container stack">
      <SectionHeader kicker={c.coverage.kicker} title={c.coverage.title} lead={c.coverage.lead} />
      <Coverage locale={locale} baseLabel={c.coverage.base} km={c.coverage.km} />
    </div>
  </section>

  <Audience kicker={c.audience.kicker} items={c.audience.items} />

  <Faq locale={locale} kicker={c.faq.kicker} title={c.faq.title} items={faqs} tone="white" />

  <section class="request" id={c.anchors.request} data-parallax-scope>
    <div class="flyby-stage">
      <SkyScene locale={locale} variant="flyby" />
      <div class="container stage-copy">
        <span class="kicker" data-reveal>{c.request.kicker}</span>
        <h2 class="display display-l" data-reveal style="--reveal-i: 1">
          {c.request.title.map((l) => <span class="block">{l}</span>)}
        </h2>
      </div>
    </div>
    <div class="container request-grid">
      <div class="request-side" data-reveal>
        <p class="lead">{c.request.text}</p>
        <p class="caption-caps accent-text">{c.request.direct}</p>
        <ul class="direct">
          <li>
            <a href={`mailto:${site.aviationEmail}`}
              ><Icon name="mail" size={18} />{site.aviationEmail}</a
            >
          </li>
          <li>
            <a href={`tel:${site.phone}`}><Icon name="phone" size={18} />{site.phoneDisplay}</a>
          </li>
          <li><span><Icon name="plane" size={18} />EDLT · Münster-Telgte</span></li>
        </ul>
      </div>
      <div class="form-panel">
        <InquiryForm locale={locale} track="aviation" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .block {
    display: block;
  }
  .stack {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .emphasis {
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(194 163 107 / 0.4);
    font-size: 0.8rem;
    font-weight: 600;
    font-stretch: 125%;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    line-height: 1.8;
  }
  .request {
    position: relative;
    background: var(--navy);
    color: var(--cloud);
    padding-bottom: var(--section-y);
  }
  .flyby-stage {
    position: relative;
    min-height: clamp(26rem, 70vh, 40rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .stage-copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.25rem;
    padding-bottom: 3rem;
  }
  .request-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem 5rem;
    padding-top: 3rem;
    align-items: start;
  }
  .request-side {
    display: grid;
    gap: 1.5rem;
  }
  .request-side .lead {
    color: rgb(245 243 238 / 0.8);
  }
  .direct {
    display: grid;
    gap: 0.9rem;
  }
  .direct a,
  .direct span {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--cloud);
  }
  .direct :global(.icon) {
    color: var(--gold);
  }
  .form-panel {
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    background: var(--navy-2);
    border: 1px solid var(--c-line);
  }
  @media (max-width: 900px) {
    .request-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
