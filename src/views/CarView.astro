---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import GiantWord from '@/components/sections/GiantWord.astro';
import PackageGrid from '@/components/sections/PackageGrid.astro';
import AddOns from '@/components/sections/AddOns.astro';
import BridgeBand from '@/components/sections/BridgeBand.astro';
import ProductPlates from '@/components/sections/ProductPlates.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import Faq from '@/components/sections/Faq.astro';
import InquiryForm from '@/components/forms/InquiryForm.astro';
import DraftMark from '@/components/global/DraftMark.astro';
import { carCopy } from '@/i18n/copy/car';
import { anchors, path, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/content/site';
import { fill, formatPrice, getFaqs, getMinPrice, getPackages } from '@/lib/content';
import { breadcrumb, businessGraph, faqPage, packageServices } from '@/lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = carCopy[locale];
const s = t(locale);
const a = anchors[locale];
const minPrice = formatPrice(await getMinPrice(), locale);
const packages = await getPackages();
const priceDraft = packages.some((p) => p.data.draft);
const faqs = await getFaqs('car', locale);
const base = Astro.site ?? new URL(Astro.url.origin);
const pagePath = path('car', locale);
const graph = [
  ...businessGraph(base, locale),
  ...packageServices(
    base,
    locale,
    packages.map((p) => ({
      id: p.id,
      name: p.data.name[locale],
      description: p.data.summary[locale],
      priceFrom: p.data.priceFrom,
    })),
  ),
  faqPage(base, pagePath, faqs),
  breadcrumb(base, [
    { name: 'Paintfix', path: path('home', locale) },
    { name: s.nav.car, path: pagePath },
  ]),
];
const tones = ['base', 'alt', 'base'] as const;
---

<BaseLayout
  locale={locale}
  routeKey="car"
  theme="auto"
  title={fill(c.seo.title, { minPrice })}
  description={fill(c.seo.description, { minPrice })}
  graph={graph}
>
  <section class="car-hero">
    <div class="hero-media parallax-subtle">
      <Img slot="auto-hero" locale={locale} priority />
    </div>
    <div class="hero-shade"></div>
    <div class="container hero-body">
      <span class="kicker" data-reveal>{c.hero.kicker}</span>
      <h1 class="display display-xl" data-reveal style="--reveal-i: 1">
        {c.hero.h1.map((l, i) => <span class:list={['block', { soft: i > 0 }]}>{l}</span>)}
      </h1>
      <p class="lead" data-reveal style="--reveal-i: 2">{c.hero.text}</p>
      <p class="hero-price" data-reveal style="--reveal-i: 2">
        {fill(c.hero.price, { minPrice })}<DraftMark draft={priceDraft} locale={locale} />
      </p>
      <div class="hero-ctas" data-reveal style="--reveal-i: 3">
        <a href={`#${a.book}`} class="btn">{s.cta.carBook}</a>
        <a href={`#${a.packages}`} class="btn btn-outline">{s.cta.carPackages}</a>
        <a href={`tel:${site.phone}`} class="hero-phone"
          ><Icon name="phone" size={18} />{site.phoneDisplay}</a
        >
      </div>
    </div>
  </section>

  <section class="statement tone-panel">
    <div class="container statement-grid" data-reveal>
      <h2 class="display display-l">
        {c.statement.title.map((l) => <span class="block">{l}</span>)}
      </h2>
      <div>
        <p class="st-lead">{c.statement.lead}</p>
        <p class="muted">{c.statement.text}</p>
      </div>
    </div>
  </section>

  {
    c.areas.map((area, i) => (
      <GiantWord
        locale={locale}
        id={area.id}
        word={area.word}
        lead={area.lead}
        cards={area.cards}
        tone={tones[i]}
      />
    ))
  }

  <section class="section tone-alt" id={a.packages}>
    <div class="container stack">
      <SectionHeader kicker={c.packages.kicker} title={c.packages.title} lead={c.packages.lead} />
      <PackageGrid
        locale={locale}
        requestHref={`#${a.book}`}
        includesLabel={c.packages.includes}
        chooseLabel={c.packages.choose}
      />
      <p class="class-note">{c.packages.classNote}</p>
      <div class="addons-block">
        <SectionHeader kicker={c.addons.kicker} title={c.addons.title} size="m" />
        <AddOns locale={locale} />
      </div>
    </div>
  </section>

  <BridgeBand
    title={c.bridge.title}
    text={c.bridge.text}
    cta={c.bridge.cta}
    href={path('aviation', locale)}
  />

  <section class="section">
    <div class="container stack">
      <SectionHeader kicker={c.products.kicker} title={c.products.title} lead={c.products.lead} />
      <ProductPlates
        locale={locale}
        plates={c.products.plates.map((p) => ({ ...p, draft: true }))}
      />
    </div>
  </section>

  <section class="section tone-alt">
    <div class="container stack">
      <SectionHeader kicker={c.process.kicker} title={c.process.title} />
      <ProcessSteps steps={c.process.steps} />
    </div>
  </section>

  <Faq locale={locale} kicker={c.faq.kicker} title={c.faq.title} items={faqs} />

  <section class="section tone-panel booking" id={a.book}>
    <div class="container booking-grid">
      <SectionHeader kicker={c.form.kicker} title={c.form.title} lead={c.form.text}>
        <ul class="direct">
          <li>
            <a href={`tel:${site.phone}`}><Icon name="phone" size={18} />{site.phoneDisplay}</a>
          </li>
          <li><a href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a></li>
        </ul>
      </SectionHeader>
      <div class="form-card" data-theme="auto">
        <InquiryForm locale={locale} track="auto" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Package links on this page scroll to the booking form and pre-select the package.
  document.querySelectorAll<HTMLAnchorElement>('a[data-package]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const form = document.querySelector<HTMLElement>('.booking');
      const select = document.querySelector<HTMLSelectElement>('[data-package-select]');
      if (!form || !select) return;
      e.preventDefault();
      select.value = link.dataset.package ?? select.value;
      form.scrollIntoView({
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
      history.replaceState(null, '', `#${form.id}`);
    });
  });
</script>

<style>
  .block {
    display: block;
  }
  .soft {
    color: color-mix(in srgb, var(--c-ink) 55%, var(--c-bg));
  }
  .stack {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .car-hero {
    position: relative;
    min-height: clamp(36rem, calc(100svh - 4.5rem), 54rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.92) 0%,
      rgb(255 255 255 / 0.65) 40%,
      transparent 72%
    );
  }
  .hero-body {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding-block: 5rem clamp(3rem, 2rem + 4vw, 6rem);
  }
  .hero-body .lead {
    color: var(--c-muted);
  }
  .hero-price {
    font-size: 1.15rem;
    font-weight: 640;
    color: var(--c-accent-text);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 0.5rem;
  }
  .hero-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    margin-left: 0.5rem;
  }
  .statement {
    background: var(--c-bg);
    color: var(--c-ink);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }
  .statement-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 5rem;
    align-items: end;
  }
  .st-lead {
    font-size: 1.15rem;
    font-weight: 560;
    margin-bottom: 0.75rem;
  }
  .class-note {
    font-size: 0.95rem;
    color: var(--c-muted);
    margin-top: -1.5rem;
  }
  .addons-block {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .booking-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 3rem 5rem;
    align-items: start;
  }
  .direct {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .direct a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 560;
  }
  .form-card {
    background: var(--white);
    color: var(--ink);
    border-radius: 6px;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }
  @media (max-width: 900px) {
    .statement-grid,
    .booking-grid {
      grid-template-columns: 1fr;
    }
    .hero-shade {
      background: linear-gradient(
        0deg,
        rgb(255 255 255 / 0.95) 0%,
        rgb(255 255 255 / 0.75) 55%,
        rgb(255 255 255 / 0.2) 100%
      );
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .parallax-subtle :global(img) {
        animation: subtle-parallax linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes subtle-parallax {
    from {
      transform: translateY(0) scale(1.05);
    }
    to {
      transform: translateY(12%) scale(1.05);
    }
  }
</style>
