---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Diptych from '@/components/sections/Diptych.astro';
import SplitPanel from '@/components/sections/SplitPanel.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import PackageGrid from '@/components/sections/PackageGrid.astro';
import AviationInterlude from '@/components/sections/AviationInterlude.astro';
import Principles from '@/components/sections/Principles.astro';
import ServiceArea from '@/components/sections/ServiceArea.astro';
import Faq from '@/components/sections/Faq.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import DraftMark from '@/components/global/DraftMark.astro';
import { homeCopy } from '@/i18n/copy/home';
import { anchors, path, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { fill, formatPrice, getFaqs, getMinPrice, getPackages } from '@/lib/content';
import { businessGraph, faqPage } from '@/lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = homeCopy[locale];
const s = t(locale);
const a = anchors[locale];
const minPrice = formatPrice(await getMinPrice(), locale);
const priceDraft = (await getPackages()).some((p) => p.data.draft);
const faqs = await getFaqs('home', locale);
const base = Astro.site ?? new URL(Astro.url.origin);
const graph = [...businessGraph(base, locale), faqPage(base, path('home', locale), faqs)];
---

<BaseLayout
  locale={locale}
  routeKey="home"
  theme="auto"
  title={c.seo.title}
  description={fill(c.seo.description, { minPrice })}
  graph={graph}
>
  <Diptych
    locale={locale}
    h1={c.hero.h1}
    intro={c.hero.intro}
    priceDraft={priceDraft}
    car={{
      ...c.hero.car,
      price: fill(c.hero.car.price, { minPrice }),
      href: path('car', locale, a.packages),
    }}
    aviation={{ ...c.hero.aviation, href: path('aviation', locale) }}
  />

  <SplitPanel locale={locale} media="home-owner">
    <span class="kicker">{c.about.kicker}</span>
    <h2 class="display display-m">{c.about.title.map((l) => <span class="block">{l}</span>)}</h2>
    {c.about.text.map((p) => <p class="muted">{p}</p>)}
    <blockquote class="quote">
      <p>„{c.about.quote}“<DraftMark locale={locale} /></p>
      <footer>{c.about.quoteBy}</footer>
    </blockquote>
  </SplitPanel>

  <section class="section">
    <div class="container stack">
      <div class="row-head">
        <SectionHeader kicker={c.packages.kicker} title={c.packages.title} lead={c.packages.lead} />
        <a href={path('car', locale, a.packages)} class="btn btn-outline"
          >{c.packages.cta} <span class="chev" aria-hidden="true">→</span></a
        >
      </div>
      <PackageGrid
        locale={locale}
        limit={3}
        compact
        requestHref={path('contact', locale)}
        chooseLabel={s.cta.carBook}
      />
    </div>
  </section>

  <AviationInterlude
    locale={locale}
    kicker={c.interlude.kicker}
    title={c.interlude.title}
    text={c.interlude.text}
    cta={c.interlude.cta}
    href={path('aviation', locale)}
  />

  <section class="section tone-alt">
    <div class="container stack">
      <SectionHeader kicker={c.principles.kicker} title={c.principles.title} />
      <Principles items={c.principles.items} />
    </div>
  </section>

  <section class="section section-tight">
    <div class="container area">
      <SectionHeader kicker={c.area.kicker} title={c.area.title} size="m" lead={c.area.text} />
      <ServiceArea locale={locale} />
    </div>
  </section>

  <Faq locale={locale} kicker={c.faq.kicker} title={c.faq.title} items={faqs} tone="alt" />

  <CtaBand
    title={c.cta.title}
    text={c.cta.text}
    primary={{ label: s.cta.carBook, href: path('contact', locale) }}
    secondary={{ label: c.cta.secondary, href: path('aviation', locale, a.request) }}
  />
</BaseLayout>

<style>
  .block {
    display: block;
  }
  .stack {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .quote {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--c-kicker);
  }
  .quote p {
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .quote footer {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-muted);
  }
  .area {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 5rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .area {
      grid-template-columns: 1fr;
    }
  }
</style>
